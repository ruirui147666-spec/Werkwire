# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Groq (parsing de CV + refinamento de explicações) ───────
# Se vazio, a app usa parsing/explicações determinísticas locais (sem LLM).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Embeddings ───────────────────────────────────────────
# 'groq' | 'local' — 'local' usa um embedding determinístico offline (fallback)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_DIMS=1024

# ── Motor de matching ────────────────────────────────────
MATCH_THRESHOLD=0.62
WORKER_DAILY_QUOTA=3
JOB_CYCLE_QUOTA=5
MATCH_EXPIRY_HOURS=48
ENGINE_VERSION=1.0.0

# ── Stripe (só lado empregador) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Interno ───────────────────────────────────────────────
CYCLE_TRIGGER_SECRET=change-me-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000
